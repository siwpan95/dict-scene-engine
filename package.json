{
  "name": "dict-scene-engine",
  "version": "0.1.1",
  "description": "字典场景引擎 —— 基于 Cordis 4.0 插件架构的文字冒险游戏引擎（场景即字典，能力即插件）",
  "type": "module",
  "main": "game.js",
  "scripts": {
    "start": "node game.js",
    "start:hmr": "node --expose-internals game.js",
    "build:hmr": "node scripts/build-hmr.mjs",
    "lint:content": "node scripts/lint-content.mjs",
    "test": "node tests/e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "game.js",
    "cordis.yml",
    "content/",
    "plugins/",
    "vendor/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "cordis",
    "text-adventure",
    "interactive-fiction",
    "game-engine",
    "plugin-architecture",
    "文字冒险",
    "游戏引擎"
  ],
  "author": "全哥 (siwpan)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/siwpan/dict-scene-engine"
  },
  "homepage": "https://gitee.com/siwpan/dict-scene-engine",
  "bugs": {
    "url": "https://gitee.com/siwpan/dict-scene-engine/issues"
  },
  "dependencies": {
    "@babel/code-frame": "^8.0.0",
    "@cordisjs/plugin-include": "1.0.5",
    "@cordisjs/plugin-loader": "1.0.0-rc.6",
    "@cordisjs/plugin-logger-console": "^1.0.0",
    "@cordisjs/plugin-timer": "^1.1.3",
    "chokidar": "^4.0.3",
    "cordis": "4.0.0-rc.9",
    "picomatch": "^4.0.7",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "js-yaml": "^4.1.0"
  }
}
